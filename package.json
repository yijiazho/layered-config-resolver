{
  "name": "layered-config-resolver",
  "version": "0.1.0",
  "description": "Resolve layered YAML configuration files with predictable precedence.",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "resolver": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean",
    "start": "npm run build && node dist/cli.js",
    "cli": "npm run build && node dist/cli.js",
    "test": "jest",
    "test:tier1": "jest --runInBand test/merge.test.ts test/loader.test.ts test/resolver.test.ts",
    "test:tier2": "jest --runInBand test/references.test.ts test/resolver.test.ts",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
